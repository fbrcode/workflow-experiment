# Shared configuration for the local experiment (decision D-004: mocks by default).
# Copy to .env to customize; the Makefile falls back to this file when .env is missing.
# Variable names are shared by the Kestra and Prefect implementations (see CLAUDE.md).
# Every value here is a local-only placeholder. Never put real secrets in this file.

# --- App database (news_email / telegram_chat) --------------------------------------------------
APP_DB_HOST=app-db              # hostname inside the compose network
APP_DB_PORT=5432                # port inside the compose network
APP_DB_NAME=news
APP_DB_USER=news
APP_DB_PASSWORD=news-local-only

# --- IMAP ingest (spec ING-1) --------------------------------------------------------------------
# Mock: GreenMail. Real Gmail: IMAP_HOST=imap.gmail.com IMAP_PORT=993 IMAP_SECURE=true + app password.
IMAP_HOST=mail
IMAP_PORT=3143
IMAP_SECURE=false
IMAP_USER=newsletters
IMAP_PASSWORD=local-only
IMAP_MAILBOX=n8n                # Gmail label / IMAP folder the baseline reads

# --- Gemini (spec SUM-5) -------------------------------------------------------------------------
# Base URL is the host root WITHOUT the API version; clients append /v1beta (the mock serves v1 and v1beta).
# Real: GEMINI_BASE_URL=https://generativelanguage.googleapis.com and a real GEMINI_API_KEY.
GEMINI_BASE_URL=http://mock-gemini:8091
GEMINI_API_KEY=mock-gemini-key
# Keep the "models/" prefix: it is part of what the baseline stores in model_used and shows in
# the Telegram header (SUM-4, SUM-6, SND-2). Strip it only when building the API URL.
GEMINI_MODEL=models/gemini-flash-lite-latest
GEMINI_MODEL_FALLBACK=models/gemini-2.5-flash

# --- Telegram (spec SUM-7b, SND-3) ---------------------------------------------------------------
# Real: TELEGRAM_BASE_URL=https://api.telegram.org and a real bot token from @BotFather.
TELEGRAM_BASE_URL=http://mock-telegram:8090
TELEGRAM_BOT_TOKEN=123456789:mock-telegram-token
TELEGRAM_ALERT_CHAT_ID=-1009999999999           # admin alert chat (hard-coded in n8n, redacted: D-010)
TELEGRAM_CHAT_ID_NEWS=-1001000000001            # seeded into telegram_chat on first DB start
TELEGRAM_CHAT_ID_FINANCE=-1001000000002
TELEGRAM_CHAT_ID_TECH=-1001000000003

# --- Kestra stack (Phase 3, docs/kestra/README.md) ----------------------------------------------
KESTRA_DB_PASSWORD=kestra-local-only            # Kestra's own metadata DB (not the app DB)
KESTRA_ADMIN_USER=admin@kestra.local            # UI/API basic auth; Kestra requires an email address
KESTRA_ADMIN_PASSWORD=Kestra-local-only1        # 8+ chars with an uppercase letter and a digit

# --- Prefect stack (Phase 4, docs/prefect/README.md) --------------------------------------------
PREFECT_DB_PASSWORD=prefect-local-only          # Prefect's own metadata DB (not the app DB)
PREFECT_ADMIN_USER=admin                        # UI/API basic auth; the UI asks for "user:password"
PREFECT_ADMIN_PASSWORD=prefect-local-only       # no ":" (the auth string is user:password)

# --- Host ports (docs/plan.md port map; 5000/7000 are taken by macOS AirPlay) -----------------
APP_DB_HOST_PORT=5433
MAIL_SMTP_HOST_PORT=3025
MAIL_IMAP_HOST_PORT=3143
MAIL_IMAPS_HOST_PORT=3993
MAIL_API_HOST_PORT=8083
MOCK_TELEGRAM_HOST_PORT=8090
MOCK_GEMINI_HOST_PORT=8091
KESTRA_HOST_PORT=8080
PREFECT_HOST_PORT=4200
