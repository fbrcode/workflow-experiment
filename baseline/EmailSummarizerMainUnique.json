      "name": "select-n8n-content-generic"
    },
    {
      "parameters": {
        "jsCode": "const TRANSLATE_IDS = new Set([\n  'lennys-newsletter',\n  'the-pragmatic-engineer',\n  'tech-brew',\n  'the-neuron',\n  'morning-brew',\n  'refactoring',\n]);\n\nconst CATEGORY_MAP = {\n  finance: new Set([\n    'rico-matinal',\n  ]),\n  news: new Set([\n    'the-news',\n    'morning-brew',\n  ]),\n};\n\nconst HTML_CONTENT_IDS = new Set([\n  'tech-brew',\n  'rico-matinal',\n]);\n\nfunction getCategory(from_name_id) {\n  for (const [category, ids] of Object.entries(CATEGORY_MAP)) {\n    if (ids.has(from_name_id)) return category;\n  }\n  return 'tech';\n}\n\nconst items = $input.all().map(item => {\n  const from = item.json.from || '';\n\n  const match = from.match(/^\"?([^\"<]+)\"?\\s*<([^>]+)>$/);\n\n  let from_name = '';\n  let from_email = '';\n\n  if (match) {\n    from_name = match[1]\n      .trim()\n      .replace(/[^\\x20-\\x7E]/g, '')\n      .trim();\n    from_email = match[2].trim();\n  } else {\n    from_email = from.trim();\n  }\n\n  const from_name_id = from_name\n    .toLowerCase()\n    .replace(/[^a-z0-9\\s]/g, '')\n    .trim()\n    .replace(/\\s+/g, '-');\n\n  const translate = TRANSLATE_IDS.has(from_name_id);\n  const category = getCategory(from_name_id);\n  const raw_content = HTML_CONTENT_IDS.has(from_name_id)\n    ? item.json.htmlContent\n    : item.json.plainContent;\n\n  // Parse date and convert to GMT-3\n  const parsed = new Date(item.json.date);\n  const gmt3 = new Date(parsed.getTime() - (3 * 60 * 60 * 1000));\n\n  const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];\n  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  const pad = n => String(n).padStart(2, '0');\n\n  const date_gmt3 = `${days[gmt3.getUTCDay()]}, ${gmt3.getUTCDate()} ${months[gmt3.getUTCMonth()]} ${gmt3.getUTCFullYear()} at ${pad(gmt3.getUTCHours())}h ${pad(gmt3.getUTCMinutes())}min`;\n\n  return {\n    json: {\n      from_name_id,\n      from_name,\n      from_email,\n      translate,\n      category,\n      date: item.json.date,\n      date_gmt3,\n      subject: item.json.subject,\n      raw_content,\n    }\n  };\n});\n\nreturn items;"
      },
